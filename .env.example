# ====================================================================
# 🌐 CONFIGURACIÓN GENERAL DEL SERVIDOR
# ====================================================================
NODE_ENV=development
APP_PORT=8080
LOG_LEVEL=info

# ====================================================================
# 🗄️ PERSISTENCIA / BASE DE DATOS POSTGRESQL 17
# ====================================================================
POSTGRES_DB=envio_seguro
POSTGRES_USER=postgres
DB_PASSWORD=postgres
PGHOST=localhost
PGPORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/envio_seguro
DB_MAX_CONNECTIONS=10

# Credenciales de Replicación para pg_basebackup y Standby
PGUSER_REPL=replicator
PGPASSWORD_REPL=ReplPasswordSeguro123

# ====================================================================
# 🔐 AUTENTICACIÓN Y SEGURIDAD
# ====================================================================
JWT_SECRET=super_secret_key_change_me_in_production
CORS_ORIGIN=http://localhost:3000
